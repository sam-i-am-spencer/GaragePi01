# GaragePi Configuration
# Copy this file to .env and update the values

# API Security - Generate a strong random key
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-secure-random-string

# GPIO Configuration
GPIO_CHIP=/dev/gpiochip4
GPIO_PIN=17
RELAY_ACTIVE_HIGH=true

# Door Sensor Configuration (Reed Switch)
DOOR_SENSOR_PIN=27

# Relay pulse duration in milliseconds
PULSE_DURATION_MS=500

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MQTT Configuration (Home Assistant integration)
# Set MQTT_HOST to your broker's IP address (e.g. your Home Assistant instance)
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# HA MQTT discovery prefix (default matches Home Assistant default)
MQTT_DISCOVERY_PREFIX=homeassistant
# Unique device ID used in MQTT topics
MQTT_DEVICE_ID=garage_pi
